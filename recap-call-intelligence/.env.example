# Sandbox keys include recap:configure + recap:read and mint with Recap on.
PYAI_API_KEY=pyai_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Recap a recording instead of the built-in utterances.
# AUDIO_FILE=./call.wav
# AUDIO_URL=https://example.com/call.mp3
# Optional: stable id you will read back (default: call_demo_<timestamp>).
# CALL_ID=call_481
# Leave unset in production (defaults to https://api.pyai.com).
# PYAI_BASE_URL=https://api.pyai.com
