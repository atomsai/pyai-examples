# Server-side secrets: mount through the runtime's secret store. Never commit a populated file.
PYAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_APPLICATION_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
ADMIN_TOKEN=
PUBLIC_ORIGIN=https://your-dedicated-test-host.example.com
JOURNAL_BUCKET=your-private-test-results
JOURNAL_PREFIX=qualification/twilio-live-translation
# Set once to an absolute UTC time no more than 30 minutes after process start.
TEST_DEADLINE=
# Optional Console rehearsal: fixed deadline up to 24 hours, 12 durable room
# reservations, one active room. Controls/join require the server-only broker.
CONSOLE_PREVIEW=0
PREVIEW_ID=
PREVIEW_OWNER=
PORT=8080
