# A unique shared secret, also configured on your Dialpad call router.
DIALPAD_ROUTER_SECRET=
# Only these Dialpad inbound numbers may use this dedicated adapter.
DIALPAD_INBOUND_NUMBERS=+12025550101
# A PyAI number already configured to answer with your agent.
PYAI_AGENT_NUMBER=+12025550102
# The existing Dialpad human destination. It must not route back to this router.
DIALPAD_HUMAN_TARGET_ID=123456
DIALPAD_HUMAN_TARGET_TYPE=department
# Leave disabled until the dedicated test call and fallback have passed.
PYAI_ROUTING_ENABLED=false
ROUTING_MODE=after_hours
BUSINESS_TIME_ZONE=America/Los_Angeles
BUSINESS_OPEN=09:00
BUSINESS_CLOSE=17:00
BUSINESS_DAYS=1,2,3,4,5
PORT=8080
# Optional setup inspection, kept server-side and never included in responses.
DIALPAD_API_KEY=
DIALPAD_OFFICE_ID=
PUBLIC_ROUTING_URL=
