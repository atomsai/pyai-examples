{
  "name": "pyai-example-omni-eval-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Simulation + eval harness: run scripted voice scenarios against a PyAI Omni agent (and the Hear stream) with no real phone call, then score them. Offline fixture mode by default (CI-safe, no network); dormant live mode against api.pyai.com.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/run.js",
    "offline": "node src/run.js",
    "live": "node --env-file=.env src/run.js --live",
    "live-pack": "node --env-file=.env src/live-pack.js",
    "live-product": "node --env-file=.env src/live-product.js",
    "live-continuity": "node --env-file=.env src/live-continuity.js",
    "score-holdout": "node src/score-holdout.js",
    "bakeoff": "node src/bakeoff-cli.js",
    "bakeoff:in-region": "bash scripts/run-in-region-bakeoff.sh",
    "bakeoff:repeated": "node src/repeated-bakeoff.js",
    "layer-e-bundle": "node src/layer-e-bundle.js",
    "layer-e-score": "node src/layer-e-score.js",
    "test:layer-d-audio": "python3 -m unittest discover -s test -p 'test_*.py'",
    "test": "node --test 'test/**/*.test.js'"
  },
  "license": "MIT",
  "dependencies": {
    "@pyai/twilio": "^0.4.0",
    "@pyai/sdk": "^0.3.0"
  }
}
