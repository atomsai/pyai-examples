# A PyAI key with the AMD scopes (amd:detect, amd:configure, amd:read).
# A sandbox key works: curl -sX POST https://api.pyai.com/v1/sandbox/keys
PYAI_API_KEY=pyai_test_...

# Where this server is reachable from Twilio (the public base URL, no trailing
# slash). Twilio fetches /twiml here and PyAI POSTs decisions to /amd-events.
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Port to listen on.
PORT=3000

# AMD operating point, 0..1. 0 = human-safe (never hang up on a person),
# 1 = fire "machine" fast. Default is human-safe.
AMD_AGGRESSIVENESS=0.25
