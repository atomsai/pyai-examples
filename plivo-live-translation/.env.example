# Mount runtime secrets from the existing secret store. Never commit populated values.
PYAI_API_KEY=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Exact dedicated application ID: 16–32 digits, used as a non-E.164 outgoing marker.
PLIVO_APP_ID=
# Three disposable endpoint usernames, all attached to that dedicated application.
PLIVO_CUSTOMER_USERNAME=
PLIVO_AGENT_USERNAME=
PLIVO_REPLACEMENT_USERNAME=
ADMIN_TOKEN=
PUBLIC_ORIGIN=https://your-dedicated-test-host.example.com
JOURNAL_BUCKET=your-private-test-results
JOURNAL_PREFIX=qualification/plivo-live-translation
# Fixed absolute UTC deadline within 30 minutes; never reset after launching.
TEST_DEADLINE=
PORT=8080
